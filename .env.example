# Copia este archivo a /etc/portal.env (o .env) y ajusta los valores.
# NUNCA subas el archivo real a Git.

# --- Portal web ---
HOST=::                       # '::' atiende IPv4 e IPv6 (Dual Stack)
PORT=3000
TRUST_PROXY=true              # true si está detrás de HAProxy (lee X-Forwarded-For)
PORTAL_NAME=Conecta Rural
SUPPORT_EMAIL=soporte@conectarural.example
# URL de inicio de sesión del portal cautivo de pfSense:
PORTAL_LOGIN_URL=https://10.10.20.1:8003/index.php?zone=prepago

# --- RADIUS (autenticación y contabilidad para pfSense) ---
RADIUS_ENABLED=true
RADIUS_SECRET=cambia-esto-por-un-secreto-largo-y-unico   # mínimo 16 caracteres; el mismo que en pfSense
RADIUS_CLIENTS=10.10.30.1,fd4a:7c21:9e05:30::1           # IP de pfSense en la VLAN 30
RADIUS_INTERIM_SECONDS=60
RADIUS_SINGLE_DEVICE=true

# --- Datos y monitoreo ---
DATA_FILE=/opt/portal/data/store.json
METRICS_TOKEN=cambia-esto-por-un-token-largo              # protege /metrics para Telegraf
ACCOUNT_VALIDITY_DAYS=30
RATE_LIMIT_PER_MINUTE=40
